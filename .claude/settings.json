{
  "autoCompactWindow": 100000,
  "autoCompactEnabled": true,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "25000"
  },
  "alwaysThinkingEnabled": true,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(**/.git/**)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "WebSearch",
      "Read(//tmp/**)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(eval:*)",
      "Bash(cargo publish:*)",
      "Bash(pip install:*)",
      "Bash(poetry add:*)",
      "Bash(poetry remove:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(go install:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker stop:*)",
      "Bash(dropdb:*)",
      "Bash(migrate:*)"
    ]
  }
}